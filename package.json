{
  "name": "stockflow",
  "version": "1.0.0",
  "private": true,
  "description": "StockFlow - Multi-Tenant SaaS Inventory Management System",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,green.bold\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "lint": "npm run lint --workspace=server && npm run lint --workspace=client",
    "typecheck": "npm run typecheck --workspace=server && npm run typecheck --workspace=client",
    "test": "npm run test --workspace=server",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f postgres",
    "docker:restart": "docker compose restart postgres",
    "db:migrate": "npm run prisma:migrate --workspace=server",
    "db:generate": "npm run prisma:generate --workspace=server",
    "db:studio": "npm run prisma:studio --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "es-abstract": "^1.24.2",
    "next": "^16.4.6"
  }
}
