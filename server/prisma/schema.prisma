// StockFlow - Prisma Database Schema
// Multi-Tenant SaaS Inventory Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// System health verification model from Phase 1
model SystemHealth {
  id        String   @id @default(uuid())
  status    String   @default("ok")
  checkedAt DateTime @default(now())

  @@map("system_health")
}

// -----------------------------------------------------------------------------
// Phase 2: Multi-Tenancy & Authentication Models
// -----------------------------------------------------------------------------

model Organization {
  id                       String    @id @default(uuid())
  name                     String
  defaultLowStockThreshold Int       @default(10)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // Enforce one user per organization for this MVP
  user     User?
  products Product[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String       @unique
  passwordHash   String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([email])
  @@map("users")
}

// -----------------------------------------------------------------------------
// Phase 3: Inventory Management - Product Model
// -----------------------------------------------------------------------------

model Product {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  sku               String
  description       String?
  quantity          Int          @default(0)
  costPrice         Decimal?     @db.Decimal(12, 2)
  sellingPrice      Decimal?     @db.Decimal(12, 2)
  lowStockThreshold Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Enforce composite uniqueness on organizationId and sku
  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, name])
  @@index([organizationId, createdAt])
  @@map("products")
}
