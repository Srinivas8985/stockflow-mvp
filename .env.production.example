# ==============================================================================
# StockFlow - Production Environment Variables Template (AWS EC2)
# Copy this file to .env.production on your AWS EC2 instance:
#   cp .env.production.example .env.production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Public IP & Let's Encrypt TLS Configuration
# ------------------------------------------------------------------------------
# Set your EC2 instance's public IPv4 address (Elastic IP)
# Let's Encrypt issues a short-lived (6-day) public IP certificate automatically
SERVER_IP=YOUR_EC2_PUBLIC_IPV4_ADDRESS

# Email address for Let's Encrypt expiry and security notifications
ACME_EMAIL=admin@example.com

# ------------------------------------------------------------------------------
# 2. Prebuilt Docker Hub Container Images
# ------------------------------------------------------------------------------
# Replace with your Docker Hub username and version tag
FRONTEND_IMAGE=yourdockerhubusername/stockflow-frontend:1.0.0
BACKEND_IMAGE=yourdockerhubusername/stockflow-backend:1.0.0

# ------------------------------------------------------------------------------
# 3. PostgreSQL Production Database Credentials
# ------------------------------------------------------------------------------
POSTGRES_USER=stockflow
# Set a strong, randomly generated database password (min 16 characters)
# Note: If your password contains special characters (@, :, /, ?, #, %, etc.),
# the application automatically URL-encodes it when connecting to the database.
POSTGRES_PASSWORD=replace_with_a_secure_random_db_password_min_16_chars
POSTGRES_DB=stockflow_prod

# Optional: You may also provide a full DATABASE_URL directly if using AWS RDS
# DATABASE_URL=postgresql://stockflow:your_password@db:5432/stockflow_prod?schema=public

# ------------------------------------------------------------------------------
# 4. Backend Security & JWT Authentication
# ------------------------------------------------------------------------------
# Generate a cryptographically random secret string (min 32 characters)
JWT_SECRET=replace_with_a_cryptographically_secure_jwt_secret_min_32_chars
JWT_EXPIRES_IN=24h
NODE_ENV=production
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 5. Frontend Configuration
# ------------------------------------------------------------------------------
# Relative path routing through Caddy reverse proxy for same-origin HTTPS requests
NEXT_PUBLIC_API_URL=/api/v1
