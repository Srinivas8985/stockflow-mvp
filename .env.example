# ==============================================================================
# StockFlow - Environment Configuration Example
# ==============================================================================
# Copy this file to .env, server/.env, and client/.env.local with appropriate values.

# ------------------------------------------------------------------------------
# Local PostgreSQL Docker Container Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=stockflow_secret
POSTGRES_DB=stockflow_dev
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Backend Configuration (server/.env)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# PostgreSQL connection string for Prisma (Local Docker or Production managed DB)
DATABASE_URL="postgresql://stockflow:stockflow_secret@localhost:5432/stockflow_dev?schema=public"

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Frontend Configuration (client/.env.local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=StockFlow
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
